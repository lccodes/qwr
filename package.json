{
  "name": "qwr-trail-map",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Offline-first mobile GPS trail navigation map for the Quogue Wildlife Refuge",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:trails": "node scripts/validate-trails.mjs",
    "sync:osm": "node scripts/sync-osm.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.469.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^3.0.4"
  }
}
